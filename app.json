{
  "expo": {
    "name": "FlowNest",
    "slug": "FlowNest",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/log_white.png",
    "scheme": "flownest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "3",
      "jsEngine": "jsc",
      "bundleIdentifier": "com.dhrumil.FlowNest",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to capture images.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "This app saves images to your photo library.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice input.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert voice into text."
      }
    },
    "android": {
      // "jsEngine": "jsc",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/log_white.png",
        "backgroundImage": "./assets/images/log_white.png",
        "monochromeImage": "./assets/images/log_white.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.FlowNest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91ef34ca-f5c3-4cc3-a08f-eb471f8616ff"
      }
    }
  }
}